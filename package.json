{
  "name": "recap-studio",
  "version": "0.6.2",
  "private": true,
  "description": "Turns a topic or your git session into one HTML explainer. Double-click to open, works offline, no JavaScript. One file to attach or send. Claude Code plugin, CLI and MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aboudjem/recap-studio.git"
  },
  "homepage": "https://github.com/Aboudjem/recap-studio#readme",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "mcp-server",
    "agent-skills",
    "explainer",
    "recap",
    "self-contained-html",
    "offline",
    "cli"
  ],
  "bin": {
    "recap-studio": "bin/recap.mjs",
    "recap": "bin/recap.mjs"
  },
  "files": [
    "bin/recap.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/content-pipeline",
    "packages/design-system",
    "packages/validation",
    "packages/html-renderer",
    "packages/mcp-server",
    "packages/cli",
    "apps/recap-web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=packages --if-present",
    "bundle": "node scripts/build-bundle.mjs",
    "bundle:check": "node scripts/build-bundle.mjs --check",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run test:workspaces && npm run test:repo",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:repo": "node --test hooks/*.test.mjs tests/*.test.mjs",
    "test:count": "node scripts/count-tests.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "demo:latest-ai-models": "node scripts/demo-latest-ai-models.mjs",
    "render": "node scripts/render-html.mjs",
    "render:demo": "node scripts/render-html.mjs latest-ai-models",
    "validate:demo": "node scripts/validate.mjs apps/recap-web/src/content/latest-ai-models.json",
    "validate": "node scripts/validate.mjs",
    "history": "node scripts/history.mjs",
    "auto-refresh": "node scripts/auto-refresh.mjs",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@recap-studio/content-pipeline": "0.1.0",
    "@recap-studio/html-renderer": "0.3.0",
    "@recap-studio/validation": "0.1.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.2",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
