{
  "$schema": "https://schemas.anthropic.com/claude-code/plugin.schema.json",
  "name": "recap-studio",
  "displayName": "Recap Studio",
  "version": "0.6.1",
  "description": "Turn a topic or a coding session into one dark-mode HTML explainer you double-click and read offline in about five minutes.",
  "author": {
    "name": "Adam Boudjemaa",
    "url": "https://github.com/Aboudjem"
  },
  "homepage": "https://github.com/Aboudjem/recap-studio",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "plugin",
    "recap",
    "explainer",
    "self-contained-html",
    "mcp",
    "cli",
    "education",
    "accessibility",
    "mobile-first"
  ],
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "recap-studio-tools": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/recap.mjs",
        "mcp"
      ]
    }
  },
  "repository": "https://github.com/Aboudjem/recap-studio"
}
